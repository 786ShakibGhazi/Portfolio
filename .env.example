# Copy to .env.local for local development. NEVER commit real values.
# Only the public (anon / publishable) key belongs here. Never put the service_role key in this project.

# Supabase > Project Settings > API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Public URL of the deployed site, including the repo path for GitHub project pages
# e.g. https://your-username.github.io/my-portfolio/   (used for canonical URL, Open Graph, sitemap)
VITE_SITE_URL=http://localhost:5173/

# URL path the site is served from. "/" for user sites / custom domains, "/repo-name/" for project pages.
VITE_BASE_PATH=/
